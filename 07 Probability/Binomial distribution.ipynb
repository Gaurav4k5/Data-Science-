   "source": [
    "from scipy.stats import binom"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "3ddee3e4-f386-4ad7-a2bc-8e26d0a7864d",
   "metadata": {},
   "source": [
    "## Probablity of exactly 6 head in 10  tosses (p = 0.5)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "91456205-8bf8-4b5e-8cd3-22fb82288834",
   "metadata": {},
   "outputs": [],
   "source": [
    "prob = binom.pmf(k=6, n=10 , p=0.5)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "aa054805-38be-4480-8e78-fe7b85503204",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "0.2050781249999999\n"
     ]
    }
   ],
   "source": [
    "print(prob)"
   ]
  }
 ],
